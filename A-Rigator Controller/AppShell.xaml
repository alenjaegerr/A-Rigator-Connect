<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="A_Rigator_Controller.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="A-Rigator Connect"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#101713}">
    <Shell.Resources>
        <Style TargetType="TabBar">
            <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light=White, Dark=#18221B}" />
            <Setter Property="Shell.TabBarForegroundColor" Value="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
            <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
            <Setter Property="Shell.TabBarUnselectedColor" Value="{AppThemeBinding Light=#718078, Dark=#83958A}" />
        </Style>
    </Shell.Resources>
</Shell>