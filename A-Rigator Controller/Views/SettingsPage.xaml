<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.Views.SettingsPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title=""
             BackgroundColor="{AppThemeBinding Light=#F1F6F2, Dark=#101A14}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Image Source="gator_focused.svg" HeightRequest="104" HorizontalOptions="End" Aspect="AspectFit" />
            <Button Text="‹  BACK TO PROFILE" Clicked="OnBackToProfileClicked"
                    HorizontalOptions="Start" MinimumHeightRequest="40"
                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
            <VerticalStackLayout Spacing="4">
                <Label Text="Settings" FontSize="30" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172A20, Dark=#EAF4EC}" />
                <Label Text="Make A-Rigator feel right for you. Manage appearance, connections and robot care." FontSize="14" TextColor="{AppThemeBinding Light=#637269, Dark=#AABBB0}" />
            </VerticalStackLayout>
            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="APPEARANCE" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="Dark mode" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#172A20, Dark=#EAF4EC}" />
                            <Label Text="Give the app a darker, easier-on-the-eyes look." FontSize="13" TextColor="{AppThemeBinding Light=#637269, Dark=#AABBB0}" />
                        </VerticalStackLayout>
                        <Switch x:Name="DarkModeSwitch" Grid.Column="1" VerticalOptions="Center" Toggled="OnDarkModeToggled" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ROBOT CONNECTIVITY" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Label Text="Connection mode" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=White}" />
                    <Label Text="Choose whether to control A-Rigator nearby or over the internet. You can change this whenever you need." FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Button Text="CHANGE CONNECTION" Clicked="OnRobotSetupClicked" MinimumHeightRequest="48" BackgroundColor="#176B45" TextColor="White" />
                    <Label Text="Wi-Fi network" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=White}" />
                    <Label Text="Manage the network A-Rigator uses for internet access. This won't affect local Bluetooth control." FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Button Text="FORGET SAVED WI-FI NETWORK" Clicked="OnForgetWifiClicked" MinimumHeightRequest="48" BackgroundColor="#8B3A3A" TextColor="White" />
                </VerticalStackLayout>
            </Border>
            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#E6C9C5, Dark=#69413C}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="DEVICE RESET" FontSize="12" FontAttributes="Bold" TextColor="#B5473C" />
                    <Label Text="Factory reset" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=White}" />
                    <Label Text="Restore A-Rigator to its out-of-box setup state. This erases its saved Wi-Fi network and operating mode. Your account and cloud irrigation profiles are not deleted." FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Button x:Name="FactoryResetButton" Text="RESET A-RIGATOR" Clicked="OnFactoryResetClicked" MinimumHeightRequest="48" BackgroundColor="#A63D36" TextColor="White" />
                </VerticalStackLayout>
            </Border>
            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="FIRMWARE" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="Installed version" FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        <Label x:Name="InstalledFirmwareVersionLabel" Grid.Column="1" Text="Not connected" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=White}" />
                    </Grid>
                    <Label Text="FIRMWARE SOURCE" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Label Text="Check whether the firmware source file has changed on GitHub." FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Label x:Name="FirmwareSourceStatusLabel" Text="Not checked yet" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=White}" />
                    <Label x:Name="FirmwareSourceDetailsLabel" Text="Checks A-RigatorBot.ino on the development branch." FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <ActivityIndicator x:Name="FirmwareSourceActivity" IsVisible="False" IsRunning="False" Color="#176B45" />
                    <Button x:Name="CheckFirmwareSourceButton" Text="CHECK FOR UPDATES" Clicked="OnCheckFirmwareSourceClicked" MinimumHeightRequest="48" BackgroundColor="#176B45" TextColor="White" />
                    <Button x:Name="ViewFirmwareCommitButton" Text="VIEW SOURCE COMMIT" Clicked="OnViewFirmwareCommitClicked" IsVisible="False" BackgroundColor="#52615A" TextColor="White" />
                </VerticalStackLayout>
            </Border>
            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="LIVE SYSTEM DIAGNOSTICS" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Connection" FontSize="13" />
                        <Label Grid.Column="1" Text="{Binding ConnectionStatus}" FontSize="13" FontAttributes="Bold" />
                        <Label Grid.Row="1" Text="Connection type" FontSize="13" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionModeLabel}" FontSize="13" FontAttributes="Bold" />
                        <Label Grid.Row="2" Text="Operating mode" FontSize="13" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding ModeStatus}" FontSize="13" FontAttributes="Bold" />
                        <Label Grid.Row="3" Text="Obstacle stop threshold" FontSize="13" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding ObstacleStopThresholdStatus}" FontSize="13" FontAttributes="Bold" />
                        <Label Grid.Row="4" Text="Manual-control timeout" FontSize="13" />
                        <Label Grid.Row="4" Grid.Column="1" Text="{Binding ManualControlTimeoutStatus}" FontSize="13" FontAttributes="Bold" />
                        <Label Grid.Row="5" Text="Obstacle distance" FontSize="13" />
                        <Label Grid.Row="5" Grid.Column="1" Text="{Binding ObstacleDistanceStatus}" FontSize="13" FontAttributes="Bold" />
                    </Grid>
                    <Label Text="{Binding ConnectionDetails}" FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="REFRESH DIAGNOSTICS" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsConnected}" BackgroundColor="#2879A8" TextColor="White" />
                        <Button Grid.Column="1" Text="RECONNECT" Command="{Binding RetryConnectionCommand}" IsEnabled="{Binding IsDisconnectedNoticeVisible}" BackgroundColor="#52615A" TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="SAFETY" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Label Text="Test autonomous movement in a clear, supervised area. Keep hands away from moving parts and stop the robot if its behavior differs from expectations." FontSize="13" TextColor="{AppThemeBinding Light=#17231C, Dark=#E0E8E2}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="A-Rigator Connect • Local-first controller" FontSize="12" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>