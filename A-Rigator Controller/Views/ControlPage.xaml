<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             xmlns:views="clr-namespace:A_Rigator_Controller.Views"
             x:Class="A_Rigator_Controller.Views.ControlPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title="Manual"
             BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#101713}">
    <Grid>
      <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Manual Control" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                <Label Text="Directly operate A-Rigator and monitor command feedback." FontSize="14" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                <ActivityIndicator IsRunning="{Binding IsCommandRunning}" IsVisible="{Binding IsCommandRunning}" Color="#238653" HorizontalOptions="Start" />
            </VerticalStackLayout>

            <Border IsVisible="{Binding IsDisconnectedNoticeVisible}" Padding="14" BackgroundColor="{AppThemeBinding Light=#FFF0D3, Dark=#3B3020}" Stroke="{AppThemeBinding Light=#E8C16D, Dark=#8B6B2D}" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ConnectionNoticeTitle}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
                    <Label Text="{Binding ConnectionRecoveryMessage}" FontSize="12" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
                    <Button Text="SEARCH FOR ROBOT" Command="{Binding RetryConnectionCommand}" MinimumHeightRequest="44" BackgroundColor="#176B45" TextColor="White" />
                    <Button Text="CONNECT THROUGH A-RIGATOR AP" Command="{Binding ConnectViaApCommand}" MinimumHeightRequest="42" BackgroundColor="{AppThemeBinding Light=#72510D, Dark=#8B6B2D}" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ACTIVE IRRIGATION PROFILE" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Picker Title="Select a saved profile" ItemsSource="{Binding IrrigationProfiles}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedIrrigationProfile}" />
                    <Label Text="{Binding SelectedIrrigationProfileSummary}" FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="MANUAL DRIVE" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="FORWARD" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="58" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Column="1" Text="REVERSE" Command="{Binding ReverseCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="58" BackgroundColor="#176B45" TextColor="White" />
                    </Grid>
                    <Button Text="STOP ALL OUTPUTS" Command="{Binding StopCommand}" IsEnabled="{Binding IsConnected}" MinimumHeightRequest="54" BackgroundColor="#A23A32" TextColor="White" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="RESET MOTOR SHIELD" Command="{Binding ResetShieldCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="44" FontSize="11" BackgroundColor="#52615A" TextColor="White" />
                        <Button Grid.Column="1" Text="REFRESH STATUS" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsConnected}" MinimumHeightRequest="44" FontSize="11" BackgroundColor="#2879A8" TextColor="White" />
                    </Grid>
                    <Label Text="Manual drive is disabled while the robot is disconnected or autonomous mode is active." FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="STEERING" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Text="LEFT" Command="{Binding SteerLeftCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="54" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Column="1" Text="CENTER" Command="{Binding SteerCenterCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="54" BackgroundColor="#52615A" TextColor="White" />
                        <Button Grid.Column="2" Text="RIGHT" Command="{Binding SteerRightCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="54" BackgroundColor="#176B45" TextColor="White" />
                    </Grid>
                    <Label Text="Uses the firmware's current calibrated steering limits: 45° left, 90° center and 135° right." FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="IRRIGATION PUMP" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Label Text="{Binding PumpStatus}" FontSize="25" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    <Button Text="SWEEP NOZZLE" Command="{Binding NozzleSweepCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="48" BackgroundColor="#2879A8" TextColor="White" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="PUMP ON" Command="{Binding PumpOnCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="52" BackgroundColor="#2879A8" TextColor="White" />
                        <Button Grid.Column="1" Text="PUMP OFF" Command="{Binding PumpOffCommand}" IsEnabled="{Binding IsConnected}" MinimumHeightRequest="52" BackgroundColor="#52615A" TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="LIVE ROBOT FEEDBACK" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Obstacle distance" FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        <Label Grid.Column="1" Text="{Binding ObstacleDistanceStatus}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                        <Label Grid.Row="1" Text="Obstacle state" FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ObstacleStatus}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                        <Label Grid.Row="2" Text="Line sensor · GPIO 14" FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding LineGpio14Status}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                        <Label Grid.Row="3" Text="Line sensor · GPIO 27" FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding LineGpio27Status}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" BackgroundColor="{AppThemeBinding Light=#FFF3DA, Dark=#342B1B}" Stroke="{AppThemeBinding Light=#E8C16D, Dark=#80652F}" StrokeShape="RoundRectangle 14">
                <Label Text="{Binding ControlAccessMessage}" FontSize="13" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
            </Border>
            <Label Text="{Binding Message}" FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
        </VerticalStackLayout>
      </ScrollView>
      <views:ConnectionOverlay IsBusy="{Binding IsConnecting}" />
    </Grid>
</ContentPage>