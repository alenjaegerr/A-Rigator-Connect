<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.Views.IrrigationProfilesPage"
             x:DataType="viewmodels:IrrigationProfilesViewModel"
             Title="Profiles"
             BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#101713}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Irrigation Profiles" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                <Label Text="Create reusable watering configurations for Manual and Autonomous operation." FontSize="14" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
            </VerticalStackLayout>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="SAVED PROFILES" FontSize="12" FontAttributes="Bold" TextColor="#238653" />
                    <Picker Title="Choose a profile" ItemsSource="{Binding Profiles}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedProfile}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="NEW PROFILE" Command="{Binding NewProfileCommand}" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Column="1" Text="DUPLICATE" Command="{Binding DuplicateCommand}" BackgroundColor="#52615A" TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="PROFILE SETTINGS" FontSize="12" FontAttributes="Bold" TextColor="#238653" />
                    <Label Text="Profile name" FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Entry Text="{Binding Name}" Placeholder="e.g. Garden beds" />
                    <Label Text="Nozzle watering duration (seconds)" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                        <Label Text="Left direction" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding LeftDuration}" Keyboard="Numeric" WidthRequest="90" />
                        <Label Grid.Row="1" Text="Back direction" VerticalOptions="Center" />
                        <Entry Grid.Row="1" Grid.Column="1" Text="{Binding BackDuration}" Keyboard="Numeric" WidthRequest="90" />
                        <Label Grid.Row="2" Text="Right direction" VerticalOptions="Center" />
                        <Entry Grid.Row="2" Grid.Column="1" Text="{Binding RightDuration}" Keyboard="Numeric" WidthRequest="90" />
                    </Grid>
                    <Label Text="Full left → back → right passes" FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Entry Text="{Binding RepeatCount}" Keyboard="Numeric" Placeholder="1" />
                    <Label Text="Each direction accepts 1–60 seconds. Repeat count accepts 1–20." FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Button Text="SAVE PROFILE" Command="{Binding SaveCommand}" MinimumHeightRequest="50" BackgroundColor="#176B45" TextColor="White" />
                    <Button Text="DELETE PROFILE" Command="{Binding DeleteCommand}" BackgroundColor="#A23A32" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" BackgroundColor="{AppThemeBinding Light=#E8F3EC, Dark=#263B2D}" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                <Label Text="{Binding Message}" FontSize="13" TextColor="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
            </Border>
            <Border Padding="14" BackgroundColor="{AppThemeBinding Light=#FFF3DA, Dark=#342B1B}" Stroke="{AppThemeBinding Light=#E8C16D, Dark=#80652F}" StrokeShape="RoundRectangle 14">
                <Label Text="Profiles are saved locally and shared by both operating screens. Applying the saved timings to the pump and nozzle will be enabled after the dedicated irrigation-sequence firmware command is added." FontSize="12" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>