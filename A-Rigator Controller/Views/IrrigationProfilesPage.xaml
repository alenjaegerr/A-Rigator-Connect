<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.Views.IrrigationProfilesPage"
             x:DataType="viewmodels:IrrigationProfilesViewModel"
             Title="Profiles"
             BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#101713}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Irrigation Profiles" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                <Label Text="Choose how the rear-facing nozzle sweeps, then set how long each selected direction receives water." FontSize="14" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                <Button Text="BACK TO AUTONOMOUS" Clicked="OnBackToAutonomousClicked" HorizontalOptions="Start" MinimumHeightRequest="42" BackgroundColor="#52615A" TextColor="White" />
            </VerticalStackLayout>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="SAVED PROFILES" FontSize="12" FontAttributes="Bold" TextColor="#238653" />
                    <Picker Title="Choose a profile" ItemsSource="{Binding Profiles}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedProfile}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="NEW PROFILE" Command="{Binding NewProfileCommand}" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Column="1" Text="DUPLICATE" Command="{Binding DuplicateCommand}" BackgroundColor="#52615A" TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="14">
                    <Label Text="PROFILE SETTINGS" FontSize="12" FontAttributes="Bold" TextColor="#238653" />
                    <Entry Text="{Binding Name}" Placeholder="Profile name (e.g. Garden beds)" />

                    <Label Text="1. CHOOSE NOZZLE SWEEP" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                        <Button Text="{Binding LeftModeLabel}" Command="{Binding SelectDirectionCommand}" CommandParameter="LeftSweep" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Column="1" Text="{Binding RightModeLabel}" Command="{Binding SelectDirectionCommand}" CommandParameter="RightSweep" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Row="1" Text="{Binding BackModeLabel}" Command="{Binding SelectDirectionCommand}" CommandParameter="BackSweep" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Row="1" Grid.Column="1" Text="{Binding BothModeLabel}" Command="{Binding SelectDirectionCommand}" CommandParameter="BothSides" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding FullModeLabel}" Command="{Binding SelectDirectionCommand}" CommandParameter="FullSweep" BackgroundColor="#176B45" TextColor="White" />
                    </Grid>

                    <Label Text="2. SET SWEEP TIMER" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    <Border Padding="12" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,*" VerticalOptions="Center">
                            <Button Grid.Column="1" Text="−" Command="{Binding DecreaseDurationCommand}" FontSize="22" WidthRequest="48" BackgroundColor="#52615A" TextColor="White" />
                            <Label Grid.Column="2" Text="{Binding DurationSeconds, StringFormat='{0} s'}" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" Margin="16,0" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                            <Button Grid.Column="3" Text="+" Command="{Binding IncreaseDurationCommand}" FontSize="22" WidthRequest="48" BackgroundColor="#176B45" TextColor="White" />
                        </Grid>
                    </Border>
                    <Label Text="Timer applies to each selected direction. Range: 1–60 seconds." FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />

                    <Label Text="3. REVIEW WATERING SEQUENCE" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    <Label Text="{Binding SequenceSummary}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
                    <Label Text="{Binding EnabledDirectionsText}" FontSize="12" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Label Text="{Binding TotalTimeText}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />

                    <Label Text="Number of passes (1–20)" FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Entry Text="{Binding RepeatCount}" Keyboard="Numeric" Placeholder="1" />
                    <Button Text="SAVE PROFILE" Command="{Binding SaveCommand}" MinimumHeightRequest="50" BackgroundColor="#176B45" TextColor="White" />
                    <Button Text="DELETE PROFILE" Command="{Binding DeleteCommand}" BackgroundColor="#A23A32" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" BackgroundColor="{AppThemeBinding Light=#E8F3EC, Dark=#263B2D}" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                <Label Text="{Binding Message}" FontSize="13" TextColor="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
            </Border>
            <Border Padding="14" BackgroundColor="{AppThemeBinding Light=#FFF3DA, Dark=#342B1B}" Stroke="{AppThemeBinding Light=#E8C16D, Dark=#80652F}" StrokeShape="RoundRectangle 14">
                <Label Text="Each selected direction gets the timer value. Every unselected direction is sent to the robot as 0 seconds and is skipped. The nozzle sweeps within that direction's calibrated arc while water is running." FontSize="12" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
