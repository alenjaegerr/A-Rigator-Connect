<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="A_Rigator_Controller.Views.IrrigationProfilesPage"
             Title="Profiles"
             BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#101713}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Irrigation Profiles" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                <Label Text="Create reusable watering configurations for different plants, pathways and operating conditions." FontSize="14" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
            </VerticalStackLayout>

            <Border Padding="18" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="PROFILE CAPABILITIES" FontSize="12" FontAttributes="Bold" TextColor="#238653" />
                    <Label Text="One profile, multiple operating modes" FontSize="21" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    <Label Text="Saved irrigation profiles will be selectable in Manual Control, Pathway Mode and Terrain Mode. Profiles will define nozzle positioning and watering behavior without changing the selected driving mode." FontSize="13" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="8">
                    <Label Text="PLANNED NOZZLE CONFIGURATION" FontSize="12" FontAttributes="Bold" TextColor="#238653" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Left direction" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                        <Label Grid.Column="1" Text="Independent duration" FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Back direction" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                        <Label Grid.Column="1" Text="Fixed position" FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Right direction" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                        <Label Grid.Column="1" Text="Independent duration" FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    </Grid>
                    <Label Text="An alternating left-to-right pattern will pause the pump while the nozzle repositions." FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" BackgroundColor="{AppThemeBinding Light=#FFF3DA, Dark=#342B1B}" Stroke="{AppThemeBinding Light=#E8C16D, Dark=#80652F}" StrokeShape="RoundRectangle 14">
                <Label Text="Profile editing and storage are intentionally not enabled in this navigation-foundation stage. The page is a structural placeholder until the nozzle and irrigation command protocol is implemented." FontSize="13" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>