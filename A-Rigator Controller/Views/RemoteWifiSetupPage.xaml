<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.Views.RemoteWifiSetupPage"
             x:DataType="viewmodels:RemoteWifiSetupViewModel"
             Title="Remote access"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#101713}">
    <Grid Padding="24">
        <Border Padding="22"
                BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}"
                Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}"
                StrokeShape="RoundRectangle 22"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <Label Text="Set up remote connection"
                       FontSize="25"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                <Label Text="Sign in to your A-Rigator account, then connect your robot to a nearby Wi-Fi network. We'll take care of the technical setup automatically."
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                <Button Text="{Binding ButtonText}"
                        Command="{Binding ContinueCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        MinimumHeightRequest="52"
                        BackgroundColor="#176B45"
                        TextColor="White" />
                <Button Text="NOT NOW"
                        Command="{Binding NotNowCommand}"
                        MinimumHeightRequest="46"
                        BackgroundColor="{AppThemeBinding Light=#EEF3EF, Dark=#2A382F}"
                        TextColor="{AppThemeBinding Light=#35443B, Dark=#E7F0E9}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>