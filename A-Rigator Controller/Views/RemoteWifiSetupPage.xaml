<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.Views.RemoteWifiSetupPage"
             x:DataType="viewmodels:RemoteWifiSetupViewModel"
             Title="Choose connection"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#101713}">
    <ScrollView>
        <VerticalStackLayout Padding="24,32,24,28" Spacing="18">
            <Label Text="A-Rigator Connect"
                   FontSize="13"
                   FontAttributes="Bold"
                   CharacterSpacing="1"
                   TextColor="#238653" />
            <Label Text="How should we connect to your robot?"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Choose how you'd like to use A-Rigator. You can change this anytime."
                   FontSize="15"
                   TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />

            <Border Padding="18"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}"
                    Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}"
                    StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="⌖" FontSize="25" TextColor="#238653" />
                        <Label Text="LOCAL" FontSize="12" FontAttributes="Bold"
                               CharacterSpacing="1" TextColor="#238653"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Control A-Rigator in front of you"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    <Label Text="Connect directly when you're near your robot. No internet needed."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Button Text="USE LOCAL"
                            Command="{Binding ChooseLocalCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            MinimumHeightRequest="50"
                            CornerRadius="14"
                            FontAttributes="Bold"
                            BackgroundColor="#238653"
                            TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}"
                    Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}"
                    StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="12">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Label Text="◎" FontSize="25" TextColor="#2879A8" />
                        <Label Text="REMOTE" FontSize="12" FontAttributes="Bold"
                               CharacterSpacing="1" TextColor="#2879A8"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Control A-Rigator anywhere in the world"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    <Label Text="Connect your robot to Wi-Fi to reach it from wherever you are."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Button Text="SET UP REMOTE ACCESS"
                            Command="{Binding ChooseRemoteCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            MinimumHeightRequest="50"
                            CornerRadius="14"
                            FontAttributes="Bold"
                            BackgroundColor="#2879A8"
                            TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>