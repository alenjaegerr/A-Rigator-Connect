<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.Views.RemoteWifiSetupPage"
             x:DataType="viewmodels:RemoteWifiSetupViewModel"
             Title=""
             Shell.NavBarIsVisible="True"
             BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#121814}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <VerticalStackLayout Spacing="6">
                <Label Text="Connect A-Rigator to nearby Wi‑Fi"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="This prepares the robot for remote connection mode. You can skip this step and continue in local mode."
                       FontSize="15"
                       TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
            </VerticalStackLayout>

            <Border Padding="18"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}"
                    Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Nearby Wi‑Fi name"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Entry Text="{Binding NetworkName, Mode=TwoWay}"
                           Placeholder="Home Wi‑Fi"
                           PlaceholderColor="{AppThemeBinding Light=#52615A, Dark=#8D9F93}"
                           TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />

                    <Label Text="Password"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Entry Text="{Binding Password, Mode=TwoWay}"
                           Placeholder="Wi‑Fi password"
                           PlaceholderColor="{AppThemeBinding Light=#52615A, Dark=#8D9F93}"
                           IsPassword="True"
                           TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />

                    <Button Text="CONNECT TO WI‑FI"
                            Command="{Binding ConnectCommand}"
                            MinimumHeightRequest="52"
                            BackgroundColor="#176B45"
                            TextColor="White" />

                    <Button Text="NOT NOW"
                            Command="{Binding NotNowCommand}"
                            MinimumHeightRequest="52"
                            BackgroundColor="#52615A"
                            TextColor="White" />

                    <Label Text="{Binding StatusMessage}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />

                    <VerticalStackLayout Spacing="10" IsVisible="{Binding IsConnectedMessageVisible}">
                        <Label Text="Wi‑Fi connected successfully."
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
                        <Button Text="CONTINUE TO DASHBOARD"
                                Command="{Binding ContinueCommand}"
                                MinimumHeightRequest="52"
                                BackgroundColor="#176B45"
                                TextColor="White" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
