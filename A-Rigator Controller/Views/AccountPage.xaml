<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.Views.AccountPage"
             x:DataType="viewmodels:AccountViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#121814}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="Account" FontSize="30" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
            <Label Text="Manage your personal account, robot identity, and saved irrigation profiles."
                   FontSize="15" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />

            <Border Padding="18" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}"
                    Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="14">
                    <Label Text="PERSONAL ACCOUNT" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
                    <Grid ColumnDefinitions="76,*" ColumnSpacing="14">
                        <Border WidthRequest="72" HeightRequest="72" StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#E7EFE9, Dark=#2B3A30}"
                                StrokeShape="RoundRectangle 36">
                            <Image Source="{Binding AvatarPath}" Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                            <Label Text="{Binding AccountSummary}" FontSize="14"
                                   TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                            <Button Text="CHANGE PROFILE PICTURE" Command="{Binding PickAvatarCommand}"
                                    FontSize="11" Padding="12,8" HorizontalOptions="Start"
                                    BackgroundColor="#2879A8" TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="Display name" FontAttributes="Bold" FontSize="14"
                           TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    <Entry Text="{Binding DisplayName, Mode=TwoWay}" Placeholder="Your name"
                           TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    <Label Text="Email address" FontSize="12"
                           TextColor="{AppThemeBinding Light=#718078, Dark=#91A196}" />
                    <Label Text="{Binding EmailAddress}" FontSize="14"
                           TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}"
                    Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="MY ROBOT" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
                    <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                        <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#E7EFE9, Dark=#2B3A30}"
                                StrokeShape="RoundRectangle 14">
                            <Image Source="{Binding RobotAvatarPath}" Aspect="AspectFit" Margin="3">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding HasRobotAvatar}" Value="False">
                                        <Setter Property="Source" Value="arigator_robot.png" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="A-Rigator" FontSize="16" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                            <Label Text="Robot nickname" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#718078, Dark=#91A196}" />
                            <Button Text="CHANGE ROBOT PHOTO" Command="{Binding PickRobotPhotoCommand}"
                                    FontSize="11" Padding="12,8" HorizontalOptions="Start"
                                    BackgroundColor="#2879A8" TextColor="White" />
                        </VerticalStackLayout>
                    </Grid>
                    <Entry Text="{Binding RobotName, Mode=TwoWay}" Placeholder="Name your robot"
                           TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}"
                    Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="IRRIGATION PROFILE SYNCHRONIZATION" FontSize="13" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
                    <Label Text="Keep your local irrigation profiles backed up to your signed-in account. Profiles created while offline will sync automatically when you sign in or internet returns."
                           FontSize="14" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Button Text="SYNC IRRIGATION PROFILES" Command="{Binding SyncProfilesCommand}"
                            IsEnabled="{Binding IsAuthenticated}" MinimumHeightRequest="52"
                            BackgroundColor="#176B45" TextColor="White" />
                    <Label Text="Sign in to enable cloud synchronization."
                           IsVisible="{Binding IsGuest}" FontSize="12"
                           TextColor="{AppThemeBinding Light=#718078, Dark=#91A196}" />
                    <Button Text="DOWNLOAD LOCAL IRRIGATION PROFILES" Command="{Binding DownloadLocalProfilesCommand}"
                            MinimumHeightRequest="52" BackgroundColor="#2879A8" TextColor="White" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#176B45" />
                    <Label Text="{Binding SyncStatus}" FontSize="13"
                           TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="SAVE ACCOUNT SETTINGS" Command="{Binding SaveAccountCommand}"
                    MinimumHeightRequest="52" BackgroundColor="#176B45" TextColor="White" />
            <Button Text="SIGN IN WITH GOOGLE" Command="{Binding SignInCommand}"
                    IsVisible="{Binding IsGuest}"
                    MinimumHeightRequest="50" BackgroundColor="#2879A8" TextColor="White" />
            <Button Text="SIGN OUT" Command="{Binding SignOutCommand}"
                    IsVisible="{Binding IsAuthenticated}" MinimumHeightRequest="50"
                    BackgroundColor="#52615A" TextColor="White" />
            <Label Text="Cloud services are managed securely by A-Rigator Connect. You don't need to configure a database or API key."
                   FontSize="12" TextColor="{AppThemeBinding Light=#718078, Dark=#91A196}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>