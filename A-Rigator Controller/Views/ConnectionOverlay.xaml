<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="A_Rigator_Controller.Views.ConnectionOverlay"
             IsVisible="False"
             Opacity="0"
             InputTransparent="True"
             HorizontalOptions="Fill"
             VerticalOptions="Fill"
             ZIndex="100">
    <Grid BackgroundColor="#990B120E" Padding="24">
        <Border Padding="24"
                BackgroundColor="{AppThemeBinding Light=#F7FAF7, Dark=#1C2820}"
                Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}"
                StrokeShape="RoundRectangle 22"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="#238653" WidthRequest="36" HeightRequest="36" />
                <Label Text="Connecting to A-Rigator"
                       FontSize="17"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                <Label Text="Establishing a local robot connection…"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
