<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.Views.AutonomousHubPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title="Autonomous"
             BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#101713}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <VerticalStackLayout Spacing="4">
                <Label Text="Autonomous Operations" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                <Label Text="Choose how A-Rigator should navigate. Each mode will have its own operating controls and live telemetry." FontSize="14" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
            </VerticalStackLayout>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ACTIVE IRRIGATION PROFILE" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Picker Title="Select a saved profile" ItemsSource="{Binding IrrigationProfiles}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedIrrigationProfile}" />
                    <Label Text="{Binding SelectedIrrigationProfileSummary}" FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="PATHWAY MODE" FontSize="12" FontAttributes="Bold" TextColor="#238653" />
                    <Label Text="Follow a designated pathway" FontSize="21" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    <Label Text="Planned: autonomous line tracing using the left and right line sensors, with irrigation profiles available during operation." FontSize="13" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Label Text="Dedicated pathway commands and operation telemetry will be connected in the Pathway implementation stage." FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Button Text="OPEN PATHWAY MODE" Clicked="OnPathwayModeClicked" MinimumHeightRequest="46" BackgroundColor="#176B45" TextColor="White" />
                    <Border Padding="9,6" HorizontalOptions="Start" BackgroundColor="{AppThemeBinding Light=#E8F3EC, Dark=#263B2D}" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                        <Label Text="INTERFACE FOUNDATION" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="TERRAIN MODE" FontSize="12" FontAttributes="Bold" TextColor="#2879A8" />
                    <Label Text="Twist-car movement" FontSize="21" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    <Label Text="Planned: continuous forward propulsion with left-right steering-servo oscillation. The operator can bias movement left or right while the twist motion continues." FontSize="13" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Label Text="This experimental mode will receive its own controller, safety handling and live telemetry. The upgraded front sonar is not required for the first version." FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Border Padding="9,6" HorizontalOptions="Start" BackgroundColor="{AppThemeBinding Light=#E8F0F6, Dark=#203341}" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                        <Label Text="EXPERIMENTAL · PLANNED" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#2879A8, Dark=#8CC7E8}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=#FFF3DA, Dark=#342B1B}" Stroke="{AppThemeBinding Light=#E8C16D, Dark=#80652F}" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="CURRENT FIRMWARE CAPABILITY" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
                    <Label Text="The current firmware exposes a general autonomous start/stop command. Dedicated Pathway and Terrain mode commands are not wired yet." FontSize="13" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
                    <Label Text="{Binding ModeStatus}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="START CURRENT ROUTINE" Command="{Binding StartAutonomousCommand}" IsEnabled="{Binding CanStartAutonomous}" MinimumHeightRequest="48" FontSize="12" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Column="1" Text="STOP" Command="{Binding StopAutonomousCommand}" IsEnabled="{Binding CanStopAutonomous}" MinimumHeightRequest="48" BackgroundColor="#A23A32" TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Connect to A-Rigator to view its current operating state. Live telemetry will be embedded in each mode's operating screen." FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>