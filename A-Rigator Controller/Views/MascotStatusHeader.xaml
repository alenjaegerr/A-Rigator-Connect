<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.Views.MascotStatusHeader"
             x:DataType="viewmodels:DashboardViewModel">
    <Border Padding="12,12"
            BackgroundColor="{AppThemeBinding Light=#173D2B, Dark=#1C3327}"
            Stroke="{AppThemeBinding Light=#2D7953, Dark=#385B43}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 24">
        <Grid ColumnDefinitions="*,1.2*,*" ColumnSpacing="6" VerticalOptions="Center">
            <VerticalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="💧" FontSize="25" HorizontalTextAlignment="Center" />
                <Label Text="WATER" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.8"
                       TextColor="#BDEBFA" HorizontalTextAlignment="Center" />
                <Label Text="{Binding WaterStatus}" FontSize="12" FontAttributes="Bold"
                       TextColor="White" HorizontalTextAlignment="Center" />
                <Label Text="Sensor pending" FontSize="9" TextColor="#B8D7C3"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
            <Image Grid.Column="1" Source="{Binding MascotImage}" HeightRequest="126"
                   Aspect="AspectFit" HorizontalOptions="Center" VerticalOptions="Center" />
            <VerticalStackLayout Grid.Column="2" Spacing="5" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="⚡" FontSize="25" HorizontalTextAlignment="Center" TextColor="#FFD34E" />
                <Label Text="POWER" FontSize="10" FontAttributes="Bold" CharacterSpacing="0.8"
                       TextColor="#FFE39A" HorizontalTextAlignment="Center" />
                <Label Text="{Binding BatteryStatus}" FontSize="12" FontAttributes="Bold"
                       TextColor="White" HorizontalTextAlignment="Center" />
                <ProgressBar Progress="{Binding BatteryProgress}" IsVisible="{Binding HasBatteryReading}" ProgressColor="#FFD34E"
                             BackgroundColor="#526A55" HeightRequest="7" WidthRequest="66" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>