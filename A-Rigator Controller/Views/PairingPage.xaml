<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             xmlns:models="clr-namespace:A_Rigator_Controller.Models"
             xmlns:views="clr-namespace:A_Rigator_Controller.Views"
             x:Class="A_Rigator_Controller.Views.PairingPage"
             x:DataType="viewmodels:PairingViewModel"
             Title="Set up A-Rigator"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F7F5">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="24,22,24,16" Spacing="10">
            <Label Text="A-Rigator setup"
                   FontSize="13"
                   FontAttributes="Bold"
                   CharacterSpacing="1"
                   TextColor="#176B45" />
            <Label Text="Let's get your robot connected."
                   FontSize="25"
                   FontAttributes="Bold"
                   TextColor="#17231C"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding SetupStepLabel}"
                   FontSize="11"
                   FontAttributes="Bold"
                   CharacterSpacing="0.7"
                   TextColor="#64736B" />
            <ProgressBar Progress="{Binding SetupProgress}"
                         ProgressColor="#176B45"
                         BackgroundColor="#DCE7E0"
                         HeightRequest="7" />
        </VerticalStackLayout>

        <ScrollView x:Name="SetupScrollView" Grid.Row="1">
            <VerticalStackLayout Padding="24,8,24,28" Spacing="16">

                <!-- STEP 1: DISCOVER AND CONNECT TO THE ROBOT -->
                <Border IsVisible="{Binding IsDiscoverStage}"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#D8E3DC"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Find your A-Rigator"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#17231C" />
                        <Label Text="Turn on your robot and keep your phone nearby. We'll use Bluetooth to find it."
                               FontSize="14"
                               TextColor="#52615A" />
                        <Button Text="Find my robot"
                                Command="{Binding ScanForBleRobotsCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                MinimumHeightRequest="52"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                BackgroundColor="#176B45"
                                TextColor="White" />
                        <Label Text="NEARBY ROBOTS"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="0.7"
                               TextColor="#718078" />
                        <CollectionView ItemsSource="{Binding NearbyBleRobots}"
                                        SelectedItem="{Binding SelectedBleRobot, Mode=TwoWay}"
                                        SelectionMode="Single"
                                        HeightRequest="170"
                                        EmptyView="No robot found yet. Turn it on, then scan again.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RobotProvisioningDevice">
                                    <Border Margin="0,3"
                                            Padding="13"
                                            BackgroundColor="#F4F8F5"
                                            Stroke="#D8E3DC"
                                            StrokeShape="RoundRectangle 14">
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                            <Border WidthRequest="42"
                                                    HeightRequest="42"
                                                    BackgroundColor="#E0EFE6"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    VerticalOptions="Center">
                                                <Label Text="🐊"
                                                       FontSize="22"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="3"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#17231C" />
                                                <Label Text="Ready to connect"
                                                       FontSize="12"
                                                       TextColor="#64736B" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2"
                                                   Text="›"
                                                   FontSize="26"
                                                   TextColor="#176B45"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{Binding BleStatusMessage}"
                               FontSize="13"
                               TextColor="#52615A" />
                        <Button Text="Connect"
                                Command="{Binding ConnectToBleRobotCommand}"
                                IsEnabled="{Binding HasSelectedBleRobot}"
                                MinimumHeightRequest="52"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                BackgroundColor="#2879A8"
                                TextColor="White" />
                        </VerticalStackLayout>
                </Border>

                <!-- STEP 2: SELECT ROUTER AND SEND CREDENTIALS -->
                <Border IsVisible="{Binding IsWifiSetupStage}"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#D8E3DC"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Connect A-Rigator to Wi-Fi"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#17231C" />
                        <Label Text="Bluetooth is connected. Select the Wi-Fi network you want the robot to use."
                               FontSize="14"
                               TextColor="#52615A" />
                        <Button Text="Find Wi-Fi networks"
                                Command="{Binding ScanWifiNetworksCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                MinimumHeightRequest="50"
                                CornerRadius="13"
                                BackgroundColor="#176B45"
                                TextColor="White" />
                        <Label Text="{Binding WifiScanStatusMessage}"
                               FontSize="13"
                               TextColor="#52615A" />
                        <CollectionView ItemsSource="{Binding NearbyWifiNetworks}"
                                        IsVisible="{Binding HasScannedWifiNetworks}"
                                        SelectedItem="{Binding SelectedWifiNetwork, Mode=TwoWay}"
                                        SelectionMode="Single"
                                        HeightRequest="210">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RobotWifiNetwork">
                                    <Border Margin="0,3"
                                            Padding="12"
                                            BackgroundColor="#F4F8F5"
                                            Stroke="#D8E3DC"
                                            StrokeShape="RoundRectangle 12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding Ssid}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#17231C" />
                                                <Label Text="Available network"
                                                       FontSize="12"
                                                       TextColor="#64736B" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="Wi-Fi"
                                                   FontSize="12"
                                                   TextColor="#52615A"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="Wi-Fi password"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="0.7"
                               TextColor="#718078" />
                        <Entry Text="{Binding WifiPassword}"
                               Placeholder="Enter your Wi-Fi password"
                               IsPassword="True"
                               ClearButtonVisibility="WhileEditing"
                               BackgroundColor="#F4F8F5"
                               TextColor="#17231C" />
                        <Button Text="Connect A-Rigator"
                                Command="{Binding ConnectRobotToWifiCommand}"
                                IsEnabled="{Binding CanSubmitWifiCredentials}"
                                MinimumHeightRequest="52"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                BackgroundColor="#2879A8"
                                TextColor="White" />
                        <Button Text="Continue with Local"
                                Command="{Binding ContinueWithBluetoothCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                MinimumHeightRequest="48"
                                CornerRadius="12"
                                BackgroundColor="#EEF3EF"
                                TextColor="#35443B" />
                        <Button Text="BACK"
                                Command="{Binding StartOverCommand}"
                                MinimumHeightRequest="44"
                                CornerRadius="12"
                                BackgroundColor="#EEF3EF"
                                TextColor="#35443B" />
                    </VerticalStackLayout>
                </Border>

                <!-- STEP 4: VERIFY REMOTE CONNECTION -->
                <Border IsVisible="{Binding IsVerifyStage}"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#D8E3DC"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Check your connection"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#17231C" />
                        <Label Text="Let's make sure A-Rigator is ready to connect."
                               FontSize="14"
                               TextColor="#52615A" />
                        <Label Text="A-Rigator will let us know when it's ready."
                               FontSize="14"
                               TextColor="#52615A" />
                        <Label Text="{Binding ResultMessage}"
                               IsVisible="{Binding IsErrorVisible}"
                               FontSize="13"
                               TextColor="#A23A32" />
                        <Button Text="Check connection"
                                Command="{Binding ConfirmWifiConnectionCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                MinimumHeightRequest="54"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                BackgroundColor="#176B45"
                                TextColor="White" />
                        <Button Text="BACK"
                                Command="{Binding BackToWifiSetupCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                MinimumHeightRequest="44"
                                CornerRadius="12"
                                BackgroundColor="#EEF3EF"
                                TextColor="#35443B" />
                    </VerticalStackLayout>
                </Border>

                <!-- SETUP COMPLETE -->
                <Border IsVisible="{Binding IsResultVisible}"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#B9D9C5"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="✓"
                               FontSize="42"
                               TextColor="#176B45"
                               HorizontalOptions="Center" />
                        <Label Text="You're all set!"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#176B45"
                               HorizontalTextAlignment="Center" />
                        <Label Text="A-Rigator is ready. Choose how you'd like to connect."
                               FontSize="14"
                               TextColor="#35443B"
                               HorizontalTextAlignment="Center" />
                        <Button Text="CONTINUE"
                                Command="{Binding OpenDashboardPreviewCommand}"
                                MinimumHeightRequest="54"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                BackgroundColor="#176B45"
                                TextColor="White" />
                        <Button Text="CHOOSE CONNECTION"
                                Command="{Binding OpenRemoteWifiSetupCommand}"
                                MinimumHeightRequest="46"
                                CornerRadius="12"
                                BackgroundColor="#EEF3EF"
                                TextColor="#35443B" />
                    </VerticalStackLayout>
                </Border>



            </VerticalStackLayout>
        </ScrollView>
        <views:ConnectionOverlay Grid.RowSpan="2" IsBusy="{Binding IsBusy}" />
    </Grid>
</ContentPage>