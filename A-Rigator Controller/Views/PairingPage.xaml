<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             xmlns:models="clr-namespace:A_Rigator_Controller.Models"
             xmlns:views="clr-namespace:A_Rigator_Controller.Views"
             x:Class="A_Rigator_Controller.Views.PairingPage"
             x:DataType="viewmodels:PairingViewModel"
             Title="Set up A-Rigator"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F7F5">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="24,22,24,16" Spacing="10">
            <Label Text="A-Rigator setup"
                   FontSize="13"
                   FontAttributes="Bold"
                   CharacterSpacing="1"
                   TextColor="#176B45" />
            <Label Text="Let's get your robot connected."
                   FontSize="25"
                   FontAttributes="Bold"
                   TextColor="#17231C"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding SetupStepLabel}"
                   FontSize="11"
                   FontAttributes="Bold"
                   CharacterSpacing="0.7"
                   TextColor="#64736B" />
            <ProgressBar Progress="{Binding SetupProgress}"
                         ProgressColor="#176B45"
                         BackgroundColor="#DCE7E0"
                         HeightRequest="7" />
        </VerticalStackLayout>

        <ScrollView x:Name="SetupScrollView" Grid.Row="1">
            <VerticalStackLayout Padding="24,8,24,28" Spacing="16">

                <!-- STEP 1: DISCOVER AND CONNECT TO THE ROBOT -->
                <Border IsVisible="{Binding IsDiscoverStage}"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#D8E3DC"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Find your A-Rigator"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#17231C" />
                        <Label Text="Turn on your robot and keep your phone nearby. We'll use Bluetooth to find it."
                               FontSize="14"
                               TextColor="#52615A" />
                        <Button Text="SCAN FOR A-RIGATOR"
                                Command="{Binding ScanForBleRobotsCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                MinimumHeightRequest="52"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                BackgroundColor="#176B45"
                                TextColor="White" />
                        <Label Text="NEARBY ROBOTS"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="0.7"
                               TextColor="#718078" />
                        <CollectionView ItemsSource="{Binding NearbyBleRobots}"
                                        SelectedItem="{Binding SelectedBleRobot, Mode=TwoWay}"
                                        SelectionMode="Single"
                                        HeightRequest="170"
                                        EmptyView="No robot found yet. Turn it on, then scan again.">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RobotProvisioningDevice">
                                    <Border Margin="0,3"
                                            Padding="13"
                                            BackgroundColor="#F4F8F5"
                                            Stroke="#D8E3DC"
                                            StrokeShape="RoundRectangle 14">
                                        <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                                            <Border WidthRequest="42"
                                                    HeightRequest="42"
                                                    BackgroundColor="#E0EFE6"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    VerticalOptions="Center">
                                                <Label Text="🐊"
                                                       FontSize="22"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="3"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#17231C" />
                                                <Label Text="{Binding SignalStrength, StringFormat='{}Bluetooth signal: {0} dBm'}"
                                                       FontSize="12"
                                                       TextColor="#64736B" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2"
                                                   Text="›"
                                                   FontSize="26"
                                                   TextColor="#176B45"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="{Binding BleStatusMessage}"
                               FontSize="13"
                               TextColor="#52615A" />
                        <Button Text="CONNECT TO SELECTED ROBOT"
                                Command="{Binding ConnectToBleRobotCommand}"
                                IsEnabled="{Binding HasSelectedBleRobot}"
                                MinimumHeightRequest="52"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                BackgroundColor="#2879A8"
                                TextColor="White" />
                        <Button Text="USE DIRECT HOTSPOT SETUP INSTEAD"
                                Command="{Binding StartDirectWifiSetupCommand}"
                                MinimumHeightRequest="46"
                                CornerRadius="12"
                                BackgroundColor="#EEF3EF"
                                TextColor="#35443B" />
                    </VerticalStackLayout>
                </Border>

                <!-- STEP 2: SELECT ROUTER AND SEND CREDENTIALS -->
                <Border IsVisible="{Binding IsWifiSetupStage}"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#D8E3DC"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Connect A-Rigator to Wi-Fi"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#17231C" />
                        <Label Text="Bluetooth is connected. Select the Wi-Fi network you want the robot to use."
                               FontSize="14"
                               TextColor="#52615A" />
                        <Button Text="SCAN FOR WI-FI NETWORKS"
                                Command="{Binding ScanWifiNetworksCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                MinimumHeightRequest="50"
                                CornerRadius="13"
                                BackgroundColor="#176B45"
                                TextColor="White" />
                        <Label Text="{Binding WifiScanStatusMessage}"
                               FontSize="13"
                               TextColor="#52615A" />
                        <CollectionView ItemsSource="{Binding NearbyWifiNetworks}"
                                        IsVisible="{Binding HasScannedWifiNetworks}"
                                        SelectedItem="{Binding SelectedWifiNetwork, Mode=TwoWay}"
                                        SelectionMode="Single"
                                        HeightRequest="210">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RobotWifiNetwork">
                                    <Border Margin="0,3"
                                            Padding="12"
                                            BackgroundColor="#F4F8F5"
                                            Stroke="#D8E3DC"
                                            StrokeShape="RoundRectangle 12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding Ssid}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#17231C" />
                                                <Label Text="{Binding IsSecured, StringFormat='{}Secured: {0}'}"
                                                       FontSize="12"
                                                       TextColor="#64736B" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding SignalStrength, StringFormat='{}{0} dBm'}"
                                                   FontSize="12"
                                                   TextColor="#52615A"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Label Text="WI-FI PASSWORD"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="0.7"
                               TextColor="#718078" />
                        <Entry Text="{Binding WifiPassword}"
                               Placeholder="Enter your Wi-Fi password"
                               IsPassword="True"
                               ClearButtonVisibility="WhileEditing"
                               BackgroundColor="#F4F8F5"
                               TextColor="#17231C" />
                        <Button Text="CONNECT A-RIGATOR"
                                Command="{Binding ConnectRobotToWifiCommand}"
                                IsEnabled="{Binding CanSubmitWifiCredentials}"
                                MinimumHeightRequest="52"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                BackgroundColor="#2879A8"
                                TextColor="White" />
                        <Button Text="SKIP ROUTER — USE DIRECT HOTSPOT"
                                Command="{Binding StartDirectWifiSetupCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                MinimumHeightRequest="46"
                                CornerRadius="12"
                                BackgroundColor="#EEF3EF"
                                TextColor="#35443B" />
                        <Button Text="BACK"
                                Command="{Binding StartOverCommand}"
                                MinimumHeightRequest="44"
                                CornerRadius="12"
                                BackgroundColor="#EEF3EF"
                                TextColor="#35443B" />
                    </VerticalStackLayout>
                </Border>

                <!-- STEP 3: REMOTE CONNECTION SETUP -->
                <Border IsVisible="{Binding IsPhoneNetworkStage}"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#D8E3DC"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="A-Rigator is connected to Wi-Fi"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#176B45" />
                        <Label Text="Your robot has received the selected router credentials. Your phone can remain on mobile data for remote access."
                               FontSize="14"
                               TextColor="#52615A" />
                        <Border Padding="14"
                                BackgroundColor="#EAF5EE"
                                Stroke="#C9E1D1"
                                StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="ROBOT WI-FI NETWORK"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.7"
                                       TextColor="#64736B" />
                                <Label Text="{Binding SelectedNetworkName}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#176B45" />
                                <Label Text="{Binding RobotAddress, StringFormat='{}Robot network address: {0}'}"
                                       FontSize="12"
                                       TextColor="#52615A" />
                            </VerticalStackLayout>
                        </Border>
                        <Label Text="Next, we'll check the remote-service setup. This does not require your phone to join the robot's Wi-Fi network."
                               FontSize="14"
                               TextColor="#35443B" />
                        <Button Text="CONTINUE"
                                Command="{Binding ContinueToVerifyCommand}"
                                MinimumHeightRequest="54"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                BackgroundColor="#176B45"
                                TextColor="White" />
                        <Button Text="BACK"
                                Command="{Binding BackToWifiSetupCommand}"
                                MinimumHeightRequest="44"
                                CornerRadius="12"
                                BackgroundColor="#EEF3EF"
                                TextColor="#35443B" />
                    </VerticalStackLayout>
                </Border>

                <!-- STEP 4: VERIFY REMOTE CONNECTION -->
                <Border IsVisible="{Binding IsVerifyStage}"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#D8E3DC"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Remote setup is ready for verification"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#17231C" />
                        <Label Text="Your phone can stay on mobile data. A-Rigator must connect to the internet through the Wi-Fi network you selected."
                               FontSize="14"
                               TextColor="#52615A" />
                        <Border Padding="14"
                                BackgroundColor="#F4F8F5"
                                Stroke="#D8E3DC"
                                StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="SETUP CHECKLIST"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="0.7"
                                       TextColor="#64736B" />
                                <Label Text="✓ Google account authenticated"
                                       FontSize="14"
                                       TextColor="#176B45" />
                                <Label Text="✓ Robot registered to your account"
                                       FontSize="14"
                                       TextColor="#176B45" />
                                <Label Text="✓ Router credentials sent to A-Rigator"
                                       FontSize="14"
                                       TextColor="#176B45" />
                                <Label Text="• Live MQTT connection and remote command test are not yet available in this app build."
                                       FontSize="13"
                                       TextColor="#8A5A18" />
                            </VerticalStackLayout>
                        </Border>
                        <Label Text="{Binding ResultMessage}"
                               IsVisible="{Binding IsErrorVisible}"
                               FontSize="13"
                               TextColor="#A23A32" />
                        <Button Text="FINISH SETUP"
                                Command="{Binding FinishRemoteSetupCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                MinimumHeightRequest="54"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                BackgroundColor="#176B45"
                                TextColor="White" />
                        <Button Text="BACK"
                                Command="{Binding BackToPhoneNetworkCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                MinimumHeightRequest="44"
                                CornerRadius="12"
                                BackgroundColor="#EEF3EF"
                                TextColor="#35443B" />
                    </VerticalStackLayout>
                </Border>

                <!-- SETUP COMPLETE -->
                <Border IsVisible="{Binding IsResultVisible}"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#B9D9C5"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="✓"
                               FontSize="42"
                               TextColor="#176B45"
                               HorizontalOptions="Center" />
                        <Label Text="You're all set!"
                               FontSize="24"
                               FontAttributes="Bold"
                               TextColor="#176B45"
                               HorizontalTextAlignment="Center" />
                        <Label Text="A-Rigator is connected and responding on your local network. You can now open the dashboard and start using your robot."
                               FontSize="14"
                               TextColor="#35443B"
                               HorizontalTextAlignment="Center" />
                        <Button Text="OPEN DASHBOARD"
                                Command="{Binding OpenDashboardPreviewCommand}"
                                MinimumHeightRequest="54"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                BackgroundColor="#176B45"
                                TextColor="White" />
                        <Button Text="SET UP ANOTHER CONNECTION"
                                Command="{Binding OpenRemoteWifiSetupCommand}"
                                MinimumHeightRequest="46"
                                CornerRadius="12"
                                BackgroundColor="#EEF3EF"
                                TextColor="#35443B" />
                    </VerticalStackLayout>
                </Border>

                <!-- LEGACY DIRECT-HOTSPOT FALLBACK -->
                <Border IsVisible="{Binding IsWifiInstructionsVisible}"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#D8E3DC"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Direct hotspot setup"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="#17231C" />
                        <Label Text="Use this offline connection when the router or cloud path is unavailable. Pair over Bluetooth first to securely retrieve the robot's unique hotspot password."
                               FontSize="14"
                               TextColor="#52615A" />
                        <Label Text="ROBOT WI-FI NETWORK"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#718078" />
                        <Label Text="{Binding RobotAccessPointSsid}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#17231C" />
                        <Label Text="{Binding AccessPointPassword, StringFormat='{}Hotspot password: {0}'}"
                               FontSize="14"
                               TextColor="#176B45" />
                        <Label Text="{Binding AccessPointStatusMessage}"
                               FontSize="12"
                               TextColor="#52615A" />
                        <Label Text="CHANGE HOTSPOT PASSWORD"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#718078" />
                        <Entry Text="{Binding NewAccessPointPassword}"
                               Placeholder="New password (8–63 characters)"
                               IsPassword="True"
                               ClearButtonVisibility="WhileEditing"
                               BackgroundColor="#F4F8F5"
                               TextColor="#17231C" />
                        <Button Text="UPDATE HOTSPOT PASSWORD"
                                Command="{Binding ChangeAccessPointPasswordCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                MinimumHeightRequest="48"
                                CornerRadius="12"
                                BackgroundColor="#2879A8"
                                TextColor="White" />
                        <Label Text="{Binding WifiStatusMessage}"
                               FontSize="13"
                               TextColor="#52615A" />
                        <Label Text="{Binding ErrorMessage}"
                               FontSize="13"
                               TextColor="#A23A32" />
                        <Label Text="{Binding ResultMessage}"
                               IsVisible="{Binding IsErrorVisible}"
                               FontSize="13"
                               TextColor="#A23A32" />
                        <Button Text="OPEN WI-FI SETTINGS"
                                Command="{Binding OpenWifiSettingsCommand}"
                                MinimumHeightRequest="50"
                                CornerRadius="13"
                                BackgroundColor="#176B45"
                                TextColor="White" />
                        <Button Text="VERIFY ROBOT CONNECTION"
                                Command="{Binding ConfirmWifiConnectionCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                MinimumHeightRequest="50"
                                CornerRadius="13"
                                BackgroundColor="#2879A8"
                                TextColor="White" />
                        <Button Text="BACK TO BLUETOOTH SETUP"
                                Command="{Binding StartOverCommand}"
                                MinimumHeightRequest="44"
                                CornerRadius="12"
                                BackgroundColor="#EEF3EF"
                                TextColor="#35443B" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
        <views:ConnectionOverlay Grid.RowSpan="2" IsBusy="{Binding IsBusy}" />
    </Grid>
</ContentPage>