<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             xmlns:views="clr-namespace:A_Rigator_Controller.Views"
             x:Class="A_Rigator_Controller.MainPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title="Home"
             BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#101713}">
    <Grid>
      <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3">
                    <Label Text="A-RIGATOR CONNECT" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#23724C, Dark=#8ED6AC}" />
                    <Label Text="{Binding Greeting}" FontSize="27" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    <Label Text="Your irrigation robot at a glance." FontSize="14" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                </VerticalStackLayout>
                <Image Grid.Column="1" Source="projectlogo.svg" WidthRequest="58" HeightRequest="58" Aspect="AspectFit" VerticalOptions="Center" />
            </Grid>

            <Border Padding="17" BackgroundColor="{AppThemeBinding Light=#173D2B, Dark=#23382B}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="ROBOT OVERVIEW" FontSize="11" FontAttributes="Bold" TextColor="#B8D7C3" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding RobotStatus}" FontSize="28" FontAttributes="Bold" TextColor="White" />
                            <Label Text="{Binding ModeStatus}" FontSize="13" TextColor="#D4E7DA" />
                            <Label Text="{Binding ConnectionModeLabel}" FontSize="12" TextColor="#B8D7C3" />
                            <Label Text="{Binding ConnectionDetails}" FontSize="11" TextColor="#B8D7C3" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Padding="10,7" BackgroundColor="#355B43" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                            <Label Text="{Binding ConnectionStatus}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding ConnectionModeDescription}" FontSize="12" TextColor="#B8D7C3" />
                    <Button Text="REFRESH STATUS" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsConnected}" MinimumHeightRequest="44" BackgroundColor="#E1F1E5" TextColor="#173D2B" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="15"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}"
                    Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="CONNECTION MODE" FontSize="11" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="{Binding LocalModeButtonText}"
                                Command="{Binding SelectBleModeCommand}"
                                MinimumHeightRequest="46"
                                BackgroundColor="#238653"
                                TextColor="White" />
                        <Button Grid.Column="1"
                                Text="{Binding RemoteModeButtonText}"
                                Command="{Binding SelectRemoteModeCommand}"
                                MinimumHeightRequest="46"
                                BackgroundColor="#2879A8"
                                TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsDisconnectedNoticeVisible}" Padding="16" BackgroundColor="{AppThemeBinding Light=#FFF0D3, Dark=#3B3020}" Stroke="{AppThemeBinding Light=#E8C16D, Dark=#8B6B2D}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding ConnectionNoticeTitle}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
                    <Label Text="{Binding ConnectionRecoveryMessage}" FontSize="13" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
                    <Button Text="Reconnect" Command="{Binding RetryConnectionCommand}" MinimumHeightRequest="48" BackgroundColor="#176B45" TextColor="White" />
                    <Button Text="Connect to another Wi-Fi network"
                            Command="{Binding ChangeWifiNetworkCommand}"
                            IsVisible="{Binding IsRemoteDisconnected}"
                            MinimumHeightRequest="46"
                            BackgroundColor="#2879A8"
                            TextColor="White" />
                    <Label Text="You'll need to be near A-Rigator to change its Wi-Fi network."
                           IsVisible="{Binding IsRemoteDisconnected}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="PUMP" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                        <Label Text="{Binding PumpStatus}" FontSize="23" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="DRIVE" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                        <Label Text="{Binding MotorStatus}" FontSize="23" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="WATER RESERVOIR" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                            <Label Text="Tank level monitoring" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Padding="9,6" BackgroundColor="{AppThemeBinding Light=#FFF0D3, Dark=#3B3020}" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                            <Label Text="SENSOR PENDING" FontSize="9" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="124,*" ColumnSpacing="16">
                        <!-- Conceptual reservoir graphic. No level or capacity is fabricated. -->
                        <Grid Grid.Column="0" WidthRequest="116" HeightRequest="176" HorizontalOptions="Center">
                            <Grid RowDefinitions="22,*,12" RowSpacing="0">
                                <Border Grid.Row="0" WidthRequest="48" HeightRequest="13" HorizontalOptions="Center" BackgroundColor="{AppThemeBinding Light=#52615A, Dark=#91A49A}" StrokeThickness="0" StrokeShape="RoundRectangle 4" />
                                <Grid Grid.Row="1" Margin="8,0">
                                    <Border Stroke="{AppThemeBinding Light=#8DA99A, Dark=#647F70}" StrokeThickness="2.5" BackgroundColor="{AppThemeBinding Light=#F1F7F2, Dark=#202E25}" StrokeShape="RoundRectangle 13">
                                        <Grid Padding="9" RowDefinitions="*,*,*">
                                            <BoxView Grid.Row="0" HeightRequest="1" VerticalOptions="End" Color="{AppThemeBinding Light=#D5E1D9, Dark=#405447}" />
                                            <BoxView Grid.Row="1" HeightRequest="1" VerticalOptions="End" Color="{AppThemeBinding Light=#D5E1D9, Dark=#405447}" />
                                            <Label Grid.Row="2" Text="TANK" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#8A9B91, Dark=#70877A}" />
                                        </Grid>
                                    </Border>
                                    <BoxView WidthRequest="2" HeightRequest="35" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,0,0,0" Color="{AppThemeBinding Light=#8DB5C7, Dark=#5E91A8}" Opacity="0.9" />
                                    <BoxView WidthRequest="42" HeightRequest="2" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,34,0,0" Color="{AppThemeBinding Light=#8DB5C7, Dark=#5E91A8}" Opacity="0.75" />
                                </Grid>
                                <Label Grid.Row="2" Text="RESERVOIR" FontSize="8" CharacterSpacing="1" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                            </Grid>
                        </Grid>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="8">
                            <Label Text="WATER LEVEL" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                            <Label Text="{Binding WaterStatus}" FontSize="21" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                            <Label Text="Waiting for the ultrasonic sensor to be installed and calibrated." FontSize="12" LineBreakMode="WordWrap" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                            <Border Padding="9,7" BackgroundColor="{AppThemeBinding Light=#EAF3EE, Dark=#26372C}" StrokeThickness="0" StrokeShape="RoundRectangle 9">
                                <Label Text="Capacity and mounting position not configured" FontSize="10" TextColor="{AppThemeBinding Light=#426451, Dark=#B8D7C3}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E4EBE6, Dark=#34443A}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="LEVEL SENSOR" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                        <Label Grid.Column="1" Text="NOT INSTALLED" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#A16A16, Dark=#F4D58D}" />
                    </Grid>
                    <Label Text="The tank graphic is ready for live readings. The fill animation, percentage and estimated volume will activate after sensor placement and empty/full calibration." FontSize="11" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />

                    <Border Padding="14" BackgroundColor="{AppThemeBinding Light=#F1F7F2, Dark=#26372C}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#3B5142}" StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Label Text="{Binding BatteryIndicatorIcon}" FontSize="30" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="BATTERY" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                                    <Label Text="{Binding BatteryHealthLabel}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#176B45, Dark=#8ED6AC}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding BatteryStatus}" FontSize="25" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" VerticalOptions="Center" />
                            </Grid>
                            <ProgressBar Progress="{Binding BatteryProgress}" ProgressColor="#39A96B" BackgroundColor="{AppThemeBinding Light=#DCE6DF, Dark=#405447}" HeightRequest="10" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding BatteryVoltageStatus}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                                <Label Grid.Column="1" Text="LIVE VOLTAGE" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding BatteryEstimateNote}" FontSize="11" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsControlWarningVisible}" Padding="14" BackgroundColor="{AppThemeBinding Light=#FFF0D3, Dark=#3B3020}" Stroke="{AppThemeBinding Light=#E8C16D, Dark=#8B6B2D}" StrokeShape="RoundRectangle 14">
                <Label Text="{Binding ControlAccessMessage}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
            </Border>

            <Label Text="A-Rigator Connect · Local-first robot companion" FontSize="12" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
        </VerticalStackLayout>
      </ScrollView>
      <views:ConnectionOverlay IsBusy="{Binding IsConnecting}" />
    </Grid>
</ContentPage>