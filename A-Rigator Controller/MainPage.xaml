<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.MainPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title="Home"
             BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#101713}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3">
                    <Label Text="A-RIGATOR CONNECT" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#23724C, Dark=#8ED6AC}" />
                    <Label Text="{Binding Greeting}" FontSize="27" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    <Label Text="Your irrigation robot at a glance." FontSize="14" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                </VerticalStackLayout>
                <Image Grid.Column="1" Source="projectlogo.svg" WidthRequest="58" HeightRequest="58" Aspect="AspectFit" VerticalOptions="Center" />
            </Grid>

            <Border Padding="17" BackgroundColor="{AppThemeBinding Light=#173D2B, Dark=#23382B}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="ROBOT OVERVIEW" FontSize="11" FontAttributes="Bold" TextColor="#B8D7C3" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <ActivityIndicator IsRunning="{Binding IsConnecting}" Color="#B8E2C5" />
                            <ActivityIndicator IsRunning="{Binding IsRefreshing}" Color="#B8E2C5" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding RobotStatus}" FontSize="28" FontAttributes="Bold" TextColor="White" />
                            <Label Text="{Binding ModeStatus}" FontSize="13" TextColor="#D4E7DA" />
                            <Label Text="{Binding ConnectionModeLabel}" FontSize="12" TextColor="#B8D7C3" />
                            <Label Text="{Binding ConnectionDetails}" FontSize="11" TextColor="#B8D7C3" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" Padding="10,7" BackgroundColor="#355B43" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                            <Label Text="{Binding ConnectionStatus}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                        </Border>
                    </Grid>
                    <Button Text="REFRESH STATUS" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsConnected}" MinimumHeightRequest="44" BackgroundColor="#E1F1E5" TextColor="#173D2B" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsDisconnectedNoticeVisible}" Padding="16" BackgroundColor="{AppThemeBinding Light=#FFF0D3, Dark=#3B3020}" Stroke="{AppThemeBinding Light=#E8C16D, Dark=#8B6B2D}" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ROBOT CONNECTION LOST" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
                    <Label Text="{Binding ConnectionRecoveryMessage}" FontSize="13" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
                    <Button Text="SEARCH FOR ROBOT" Command="{Binding RetryConnectionCommand}" MinimumHeightRequest="48" BackgroundColor="#176B45" TextColor="White" />
                    <Button Text="CONNECT THROUGH A-RIGATOR AP" Command="{Binding ConnectViaApCommand}" MinimumHeightRequest="46" BackgroundColor="{AppThemeBinding Light=#72510D, Dark=#8B6B2D}" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="PUMP" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                        <Label Text="{Binding PumpStatus}" FontSize="23" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="DRIVE" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                        <Label Text="{Binding MotorStatus}" FontSize="23" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2820}" Stroke="{AppThemeBinding Light=#DCE6DF, Dark=#34443A}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="9">
                    <Label Text="ROBOT HEALTH" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Water level" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                        <Label Grid.Column="1" Text="{Binding WaterStatus}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Battery" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                        <Label Grid.Column="1" Text="{Binding BatteryStatus}" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                    </Grid>
                    <Label Text="Water and battery readings will appear when the firmware reports those measurements." FontSize="12" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsControlWarningVisible}" Padding="14" BackgroundColor="{AppThemeBinding Light=#FFF0D3, Dark=#3B3020}" Stroke="{AppThemeBinding Light=#E8C16D, Dark=#8B6B2D}" StrokeShape="RoundRectangle 14">
                <Label Text="{Binding ControlAccessMessage}" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
            </Border>

            <Label Text="A-Rigator Connect · Local-first robot companion" FontSize="12" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#64736A, Dark=#AAB8AE}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>