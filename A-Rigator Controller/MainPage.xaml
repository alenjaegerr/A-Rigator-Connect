<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.MainPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F3F6F3, Dark=#121814}">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="3">
                    <Label Text="A-RIGATOR CONNECT" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#23724C, Dark=#8ED6AC}" />
                    <Label Text="{Binding Greeting}" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    <Label Text="Smart irrigation control center" FontSize="14" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" Padding="10,7" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center" BackgroundColor="{AppThemeBinding Light=#E5F5E9, Dark=#35483A}">
                    <Label Text="{Binding ConnectionStatus}" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#173D2B, Dark=#E7F0E9}" />
                </Border>
            </Grid>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=#173D2B, Dark=#2B4032}" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="ROBOT STATUS" FontSize="11" FontAttributes="Bold" TextColor="#B8D7C3" />
                        <Label Text="{Binding RobotStatus}" FontSize="25" FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding ModeStatus}" FontSize="13" TextColor="#D4E7DA" />
                    </VerticalStackLayout>
                    <Image Grid.Column="1" Source="projectlogo.svg" WidthRequest="82" HeightRequest="82" Aspect="AspectFit" VerticalOptions="Center" />
                    <Button Grid.Row="2" Grid.ColumnSpan="2" Text="REFRESH TELEMETRY" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsConnected}" MinimumHeightRequest="42" BackgroundColor="#E1F1E5" TextColor="#173D2B" />
                </Grid>
            </Border>

            <Border Padding="13" IsVisible="{Binding IsControlWarningVisible}" BackgroundColor="{AppThemeBinding Light=#FFF0D3, Dark=#3B3020}" Stroke="{AppThemeBinding Light=#E8C16D, Dark=#8B6B2D}" StrokeShape="RoundRectangle 12">
                <Label Text="{Binding ControlAccessMessage}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Padding="14" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 15">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="PUMP" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        <Label Text="{Binding PumpStatus}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Padding="14" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 15">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="DRIVE" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        <Label Text="{Binding MotorStatus}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="14" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 15">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="OPERATING MODE" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        <Label Text="{Binding ModeStatus}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="AUTONOMOUS IRRIGATION" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                        <Label Text="Let A-Rigator follow its programmed route, detect obstacles, and irrigate automatically." FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    </VerticalStackLayout>
                    <Border Padding="12" BackgroundColor="{AppThemeBinding Light=#F3F6F3, Dark=#121814}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding ModeStatus}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#23724C, Dark=#8ED6AC}" />
                            <Label Text="{Binding Message}" FontSize="12" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        </VerticalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="START AUTONOMOUS" Command="{Binding StartAutonomousCommand}" IsEnabled="{Binding CanStartAutonomous}" MinimumHeightRequest="48" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Column="1" Text="STOP AUTONOMOUS" Command="{Binding StopAutonomousCommand}" IsEnabled="{Binding CanStopAutonomous}" MinimumHeightRequest="48" BackgroundColor="#A23A32" TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="MANUAL CONTROLS" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Button Text="FORWARD" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="48" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Column="1" Text="REVERSE" Command="{Binding ReverseCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="48" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Row="1" Text="PUMP ON" Command="{Binding PumpOnCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="48" BackgroundColor="#2879A8" TextColor="White" />
                        <Button Grid.Row="1" Grid.Column="1" Text="PUMP OFF" Command="{Binding PumpOffCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="48" BackgroundColor="#52615A" TextColor="White" />
                    </Grid>
                    <Button Text="STOP ALL OUTPUTS" Command="{Binding StopCommand}" IsEnabled="{Binding IsConnected}" MinimumHeightRequest="48" BackgroundColor="#A23A32" TextColor="White" />
                    <Button Text="RESET MOTOR SHIELD" Command="{Binding ResetShieldCommand}" IsEnabled="{Binding CanManualControl}" MinimumHeightRequest="44" BackgroundColor="#72510D" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Label Text="A-Rigator Connect • Local-first robot control" FontSize="12" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>