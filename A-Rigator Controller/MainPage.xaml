<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.MainPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title=""
             Shell.NavBarIsVisible="True"
             BackgroundColor="{AppThemeBinding Light=#F3F6F3, Dark=#121814}">
    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                <VerticalStackLayout Spacing="3">
                    <Label Text="A-RIGATOR CONNECT" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#23724C, Dark=#8ED6AC}" />
                    <Label Text="{Binding Greeting}" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    <Label Text="Smart irrigation control center" FontSize="14" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" Padding="10,7" StrokeThickness="0" StrokeShape="RoundRectangle 12" VerticalOptions="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F9E2E2, Dark=#482B2D}" />
                            <Style.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E5F5E9, Dark=#35483A}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView WidthRequest="8" HeightRequest="8" Color="{Binding ConnectionDotColor}" CornerRadius="4" VerticalOptions="Center" />
                        <Label Text="{Binding ConnectionStatus}" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=#173D2B, Dark=#2B4032}" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="ROBOT STATUS" FontSize="11" FontAttributes="Bold" TextColor="#B8D7C3" />
                        <Label Text="{Binding RobotStatus}" FontSize="25" FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding ModeSummary}" FontSize="13" TextColor="#D4E7DA" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Grid.RowSpan="2" Padding="12" BackgroundColor="#2D5D43" StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                            <Label Text="MODE" FontSize="10" FontAttributes="Bold" TextColor="#B8D7C3" HorizontalTextAlignment="Center" />
                            <Label Text="{Binding ModeStatus}" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Label Grid.Row="1" Text="{Binding LastUpdatedText}" FontSize="11" TextColor="#B8D7C3" />
                    <Button Grid.Row="2" Grid.ColumnSpan="2" Text="REFRESH TELEMETRY" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsConnected}" MinimumHeightRequest="42" BackgroundColor="#E1F1E5" TextColor="#173D2B" />
                </Grid>
            </Border>

            <Border Padding="13" IsVisible="{Binding IsControlWarningVisible}" BackgroundColor="{AppThemeBinding Light=#FFF0D3, Dark=#3B3020}" Stroke="{AppThemeBinding Light=#E8C16D, Dark=#8B6B2D}" StrokeShape="RoundRectangle 12">
                <Label Text="{Binding ControlAccessMessage}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#72510D, Dark=#F4D58D}" />
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Padding="14" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 15">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="PUMP" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        <Label Grid.Row="1" Text="{Binding PumpStatus}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                        <Label Grid.Column="1" Grid.RowSpan="2" Text="◉" FontSize="24" TextColor="#2879A8" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Padding="14" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 15">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="DRIVE" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        <Label Grid.Row="1" Text="{Binding MotorStatus}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                        <Label Grid.Column="1" Grid.RowSpan="2" Text="↗" FontSize="25" TextColor="{AppThemeBinding Light=#23724C, Dark=#8ED6AC}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Padding="14" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 15">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="OBSTACLE DISTANCE" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        <Label Text="{Binding ObstacleDistanceText}" FontSize="19" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="14" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 15">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="LINE SENSORS" FontSize="10" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        <Label Text="{Binding LineSensorSummary}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="AUTONOMOUS IRRIGATION" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                        <Label Text="Let A-Rigator follow its line, avoid obstacles, and irrigate marked zones." FontSize="13" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    </VerticalStackLayout>
                    <Border Padding="12" BackgroundColor="{AppThemeBinding Light=#F3F6F3, Dark=#121814}" StrokeThickness="0" StrokeShape="RoundRectangle 12">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding AutonomousStatusTitle}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#23724C, Dark=#8ED6AC}" />
                            <Label Text="{Binding AutonomousStatusDescription}" FontSize="12" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        </VerticalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="START AUTONOMOUS" Command="{Binding StartAutonomousCommand}" IsEnabled="{Binding CanControl}" MinimumHeightRequest="48" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Column="1" Text="STOP ROBOT" Command="{Binding StopCommand}" IsEnabled="{Binding IsConnected}" MinimumHeightRequest="48" BackgroundColor="#A23A32" TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="WATER LEVEL" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                            <Label Text="Tank monitoring" FontSize="12" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding WaterStatus}" FontSize="13" FontAttributes="Bold" TextColor="#2879A8" VerticalOptions="Center" />
                    </Grid>
                    <Grid HeightRequest="86" ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*" ColumnSpacing="4" VerticalOptions="End">
                        <BoxView Grid.Column="0" HeightRequest="12" VerticalOptions="End" Color="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" CornerRadius="3" />
                        <BoxView Grid.Column="1" HeightRequest="20" VerticalOptions="End" Color="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" CornerRadius="3" />
                        <BoxView Grid.Column="2" HeightRequest="28" VerticalOptions="End" Color="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" CornerRadius="3" />
                        <BoxView Grid.Column="3" HeightRequest="36" VerticalOptions="End" Color="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" CornerRadius="3" />
                        <BoxView Grid.Column="4" HeightRequest="44" VerticalOptions="End" Color="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" CornerRadius="3" />
                        <BoxView Grid.Column="5" HeightRequest="52" VerticalOptions="End" Color="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" CornerRadius="3" />
                        <BoxView Grid.Column="6" HeightRequest="60" VerticalOptions="End" Color="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" CornerRadius="3" />
                        <BoxView Grid.Column="7" HeightRequest="68" VerticalOptions="End" Color="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" CornerRadius="3" />
                        <BoxView Grid.Column="8" HeightRequest="60" VerticalOptions="End" Color="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" CornerRadius="3" />
                        <BoxView Grid.Column="9" HeightRequest="48" VerticalOptions="End" Color="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" CornerRadius="3" />
                        <BoxView Grid.Column="10" HeightRequest="34" VerticalOptions="End" Color="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" CornerRadius="3" />
                        <BoxView Grid.Column="11" HeightRequest="22" VerticalOptions="End" Color="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" CornerRadius="3" />
                    </Grid>
                    <Label Text="{Binding WaterGraphMessage}" FontSize="12" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#202A23}" Stroke="{AppThemeBinding Light=#D8E3DC, Dark=#3B4A40}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12">
                    <Label Text="MANUAL CONTROLS" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <Button Text="FORWARD" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanControl}" MinimumHeightRequest="48" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Column="1" Text="REVERSE" Command="{Binding ReverseCommand}" IsEnabled="{Binding CanControl}" MinimumHeightRequest="48" BackgroundColor="#176B45" TextColor="White" />
                        <Button Grid.Row="1" Text="PUMP ON" Command="{Binding PumpOnCommand}" IsEnabled="{Binding CanControl}" MinimumHeightRequest="48" BackgroundColor="#2879A8" TextColor="White" />
                        <Button Grid.Row="1" Grid.Column="1" Text="PUMP OFF" Command="{Binding PumpOffCommand}" IsEnabled="{Binding IsConnected}" MinimumHeightRequest="48" BackgroundColor="#52615A" TextColor="White" />
                    </Grid>
                    <Button Text="RESET MOTOR SHIELD" Command="{Binding ResetShieldCommand}" IsEnabled="{Binding CanControl}" MinimumHeightRequest="44" BackgroundColor="#72510D" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="14" BackgroundColor="{AppThemeBinding Light=#E9F0EB, Dark=#26352B}" StrokeThickness="0" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="5">
                    <Label Text="SYSTEM MESSAGE" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#52615A, Dark=#B3C3B9}" />
                    <Label Text="{Binding Message}" FontSize="13" TextColor="{AppThemeBinding Light=#17231C, Dark=#E7F0E9}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>