<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:A_Rigator_Controller.ViewModels"
             x:Class="A_Rigator_Controller.MainPage"
             x:DataType="viewmodels:DashboardViewModel"
             Title="Dashboard"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F7F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <VerticalStackLayout Spacing="5">
                <Image Source="projectlogo.svg"
                       HeightRequest="170"
                       MaximumWidthRequest="300"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       SemanticProperties.Description="A-Rigator robot project logo" />
                <Label Text="A-RIGATOR CONNECT"
                       FontSize="23"
                       FontAttributes="Bold"
                       TextColor="#176B45"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Local robot dashboard"
                       FontSize="15"
                       TextColor="#52615A" />
                <Label Text="{Binding Greeting}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#176B45" />
            </VerticalStackLayout>

            <Border Padding="12"
                    IsVisible="{Binding IsControlWarningVisible}"
                    BackgroundColor="#FFF1D6"
                    Stroke="#E9BA58"
                    StrokeShape="RoundRectangle 12">
                <Label Text="{Binding ControlAccessMessage}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#72510D" />
            </Border>

            <Border Padding="18"
                    BackgroundColor="White"
                    Stroke="#D8E3DC"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding RobotName}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#17231C" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Border Grid.Row="0" Grid.Column="0" Padding="14" BackgroundColor="White" Stroke="#D8E3DC" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="CONNECTION" FontSize="12" FontAttributes="Bold" TextColor="#52615A" />
                        <Label Text="{Binding ConnectionStatus}" FontSize="15" FontAttributes="Bold" TextColor="#17231C" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Padding="14" BackgroundColor="White" Stroke="#D8E3DC" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="MOTOR" FontSize="12" FontAttributes="Bold" TextColor="#52615A" />
                        <Label Text="{Binding MotorStatus}" FontSize="15" FontAttributes="Bold" TextColor="#17231C" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Padding="14" BackgroundColor="White" Stroke="#D8E3DC" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="ROBOT STATE" FontSize="12" FontAttributes="Bold" TextColor="#52615A" />
                        <Label Text="{Binding RobotStatus}" FontSize="15" FontAttributes="Bold" TextColor="#17231C" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="14" BackgroundColor="White" Stroke="#D8E3DC" StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="PUMP" FontSize="12" FontAttributes="Bold" TextColor="#52615A" />
                        <Label Text="{Binding PumpStatus}" FontSize="15" FontAttributes="Bold" TextColor="#17231C" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="CONTROLS" FontSize="14" FontAttributes="Bold" TextColor="#52615A" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Button Grid.Row="0" Grid.Column="0" Text="FORWARD" Command="{Binding ForwardCommand}" IsEnabled="{Binding CanControl}" MinimumHeightRequest="54" BackgroundColor="#176B45" TextColor="White" />
                <Button Grid.Row="0" Grid.Column="1" Text="REVERSE" Command="{Binding ReverseCommand}" IsEnabled="{Binding CanControl}" MinimumHeightRequest="54" BackgroundColor="#176B45" TextColor="White" />
                <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="STOP" Command="{Binding StopCommand}" MinimumHeightRequest="58" BackgroundColor="#A23A32" TextColor="White" />
                <Button Grid.Row="2" Grid.Column="0" Text="PUMP ON" Command="{Binding PumpOnCommand}" IsEnabled="{Binding CanControl}" MinimumHeightRequest="54" BackgroundColor="#2879A8" TextColor="White" />
                <Button Grid.Row="2" Grid.Column="1" Text="PUMP OFF" Command="{Binding PumpOffCommand}" MinimumHeightRequest="54" BackgroundColor="#52615A" TextColor="White" />
                <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Text="RESET MOTOR SHIELD" Command="{Binding ResetShieldCommand}" IsEnabled="{Binding CanControl}" MinimumHeightRequest="50" BackgroundColor="#72510D" TextColor="White" />
            </Grid>

            <Label Text="{Binding Message}" FontSize="14" TextColor="#52615A" />
            <Button Text="REFRESH STATUS" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanControl}" MinimumHeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
